% ----------------------------------------------------------
% Alterações da Capa (inclusão do Brasão)
% ----------------------------------------------------------
\renewcommand{\imprimircapa}{
  \begin{capa}
    \center
    
    % Brasão (mude a escala para diminuir/aumentar)
    \begin{figure}
      \centering
      \includegraphics[scale=0.13]{abntex-ifpi/logo_ifpi.pdf}
    \end{figure}\vspace*{-1.25cm}
    
    % Nome da Instituição
    {\ABNTEXchapterfont\bfseries\imprimirinstituicao\vspace*{3.5cm}}
	
    % Autor do Trabalho
    {\ABNTEXchapterfont\bfseries\MakeUppercase{\imprimirautor}\vspace*{3.5cm}}
    	
    % Título do Trabalho
    {\ABNTEXchapterfont\bfseries\MakeUppercase{\imprimirtitulo}}
    \vspace*{\fill}
	
    % Local e Ano
    {\bfseries\MakeUppercase{\imprimirlocal}}
    \par
    {\bfseries\imprimirdata}

    \vspace*{1cm}
  \end{capa}
}


% ----------------------------------------------------------
% Folha de Rosto (contracapa)
% ----------------------------------------------------------
\renewcommand{\folhaderostocontent}{
\begin{center}
  {\ABNTEXchapterfont\MakeUppercase{\imprimirautor}}

  \vspace*{3.5cm}

  {\ABNTEXchapterfont\MakeUppercase{\imprimirtitulo}}

  \vspace*{\fill}

  \abntex@ifnotempty{\imprimirpreambulo}{
    \hspace*{.5\textwidth}%
    \begin{minipage}{.5\textwidth}
      \SingleSpacing
      \imprimirpreambulo
    \end{minipage}
  }

  \abntex@ifnotempty{\imprimirorientador}{
    \hspace*{.5\textwidth}%
    \begin{minipage}{.5\textwidth}
      \SingleSpacing
      \raggedright
      Orientador: \imprimirorientador.
      \abntex@ifnotempty{\imprimircoorientador}{%
        \\Coorientador: \imprimircoorientador.}
    \end{minipage}
    \vspace*{\fill}
  }



  \vspace*{\fill}
  {\MakeUppercase{\imprimirlocal}}
  \par
  {\imprimirdata}
  \vspace*{1cm}
\end{center}
}



% ----------------------------------------------------------
% Folha de Aprovação
%
% O nome que aparece sob cada assinatura vem do comando abaixo. Para trocá-lo
% (outro campus, por exemplo), use \renewcommand{\instituicaodabanca}{...}
% em configuracoes/metadados.tex.
% ----------------------------------------------------------
\newcommand{\instituicaodabanca}{Instituto Federal de Educação, Ciência e Tecnologia do Piauí (IFPI)}

\newcommand{\imprimirfolhadeaprovacao}{
\begin{folhadeaprovacao}
  \begin{center}
    {\ABNTEXchapterfont\MakeUppercase{\imprimirautor}}
    \vspace*{\fill}

    \vspace*{\fill}
    {\ABNTEXchapterfont\MakeUppercase{\imprimirtitulo}}
    \vspace*{\fill}

    \hspace*{.5\textwidth}%
    \begin{minipage}{.5\textwidth}
      % Natureza do trabalho em espaço simples (manual, seção 3.3, alínea b),
      % mesmo quando o corpo do texto estiver em 1,5 (monografia e tese).
      \SingleSpacing
      \imprimirpreambulo
    \end{minipage}
    \vspace*{\fill}
  \end{center}
Aprovado em \imprimirdataapresentacao.
\par
  \begin{center}
  	

    
  	BANCA EXAMINADORA:
  \end{center}

  \setlength{\ABNTEXsignwidth}{12cm}
  \setlength{\ABNTEXsignskip}{0.5cm}
  \assinatura{\textbf{\imprimirorientador~(Orientador)} \\ \instituicaodabanca}
  \assinatura{\textbf{\imprimirmembroum} \\ \instituicaodabanca}
  \assinatura{\textbf{\imprimirmembrodois} \\ \instituicaodabanca}
  % Esta folha tem três assinaturas. Para quatro, use
  % \imprimirfolhadeaprovacaoduascolunas, que também imprime \membrotres.

  \begin{center}
    \vspace*{\fill}
    {\MakeUppercase{\imprimirlocal}}
    \par
    {\imprimirdata}
    \vspace*{1cm}
  \end{center}

\end{folhadeaprovacao}
}


% ----------------------------------------------------------
% Folha de Aprovação - Duas Colunas (para 4 membros)
% ----------------------------------------------------------
\newcommand{\imprimirfolhadeaprovacaoduascolunas}{
\begin{folhadeaprovacao}
  \begin{center}
    {\ABNTEXchapterfont\MakeUppercase{\imprimirautor}}
    \vspace*{\fill}

    \vspace*{\fill}
    {\ABNTEXchapterfont\MakeUppercase{\imprimirtitulo}}
    \vspace*{\fill}

    \hspace*{.5\textwidth}%
    \begin{minipage}{.5\textwidth}
      % Natureza do trabalho em espaço simples (manual, seção 3.3, alínea b),
      % mesmo quando o corpo do texto estiver em 1,5 (monografia e tese).
      \SingleSpacing
      \imprimirpreambulo
    \end{minipage}
    \vspace*{\fill}
  \end{center}

