% ----------------------------------------------------------
% Identificação do pacote
% ----------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}[2021/06/01]
\ProvidesPackage{abntex-ifpi/abntex-ifpi}[2026/09/23 v2.1 Estilo IFPI para abnTeX2 - Manual de Normalizacao do IFPI 2024]

% Este pacote só funciona com a classe abntex2: ele redefine comandos que
% pertencem a ela. Se a classe não estiver carregada, avise de forma clara em
% vez de despejar dezenas de "Undefined control sequence".
\@ifclassloaded{abntex2}{}{%
  \PackageError{abntex-ifpi}
    {Este pacote exige a classe abntex2}
    {Use \string\documentclass{abntex2} em main.tex antes de carregar
     abntex-ifpi/abntex-ifpi.}%
}

% ----------------------------------------------------------
% Pacotes utilizados
% ----------------------------------------------------------
\RequirePackage{float}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage[many]{tcolorbox}
\RequirePackage{amsthm}
\RequirePackage{enumitem}   % usado pela lista personalizada mais abaixo

% ----------------------------------------------------------
% TÍTULOS DE SEÇÃO -- numeração progressiva (manual IFPI 2024, seção 3.7;
% ABNT NBR 6024:2012)
%
% Base: https://github.com/marbutto/tcc/blob/master/tcc.cls
% Autor: Matheus Liberatos, matheusliberatosbs@gmail.com
%
% O manual exige que TODOS os títulos fiquem em tamanho 12 (= \normalsize
% neste documento) e que os níveis se distingam entre si por recurso
% tipográfico hierárquico (seção 3.7; a norma LIMITA a numeração à seção
% quinária, não obriga a usá-la). A hierarquia adotada aqui é a do exemplo
% do manual (seção 7.3.3.5):
%
%   1 SEÇÃO PRIMÁRIA            \section            maiúsculas + negrito
%   1.1 SEÇÃO SECUNDÁRIA        \subsection         maiúsculas
%   1.1.1 Seção terciária       \subsubsection      negrito
%   1.1.1.1 Seção quaternária   \subsubsubsection   itálico
%
% ATENÇÃO: o abnTeX2 oferece QUATRO níveis numerados; não existe comando de
% seção quinária. Não use \paragraph para tentar criar um quinto nível: ele
% é o mesmo nível de \subsubsubsection e sai numerado como se fosse outra
% seção quaternária (1.1.1.2). Precisando de cinco níveis, reorganize o texto.
%
% As maiúsculas vêm das opções section=TITLE e subsection=TITLE em main.tex;
% aqui ficam apenas os destaques (negrito/itálico). Para mudar a aparência
% de um nível, altere só o tamanho/estilo correspondente abaixo.
% ----------------------------------------------------------
\renewcommand{\ABNTEXchapterfont}{}
\renewcommand{\ABNTEXchapterfontsize}{\normalsize\bfseries}
\renewcommand{\ABNTEXpartfont}{\ABNTEXchapterfont}
\renewcommand{\ABNTEXpartfontsize}{\ABNTEXchapterfontsize}

% \section -- seção primária
\renewcommand{\ABNTEXsectionfont}{\ABNTEXchapterfont}
\renewcommand{\ABNTEXsectionfontsize}{\normalsize\bfseries}

% \subsection -- seção secundária
\renewcommand{\ABNTEXsubsectionfont}{\ABNTEXchapterfont}
\renewcommand{\ABNTEXsubsectionfontsize}{\normalsize}

% \subsubsection (terciária) e \subsubsubsection (quaternária)
\renewcommand{\ABNTEXsubsubsectionfont}{\ABNTEXsubsectionfont}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize\bfseries}
\renewcommand{\ABNTEXsubsubsubsectionfont}{\ABNTEXsubsectionfont}
\renewcommand{\ABNTEXsubsubsubsectionfontsize}{\normalsize\itshape}

% ----------------------------------------------------------
% INDICATIVO DE SEÇÃO (manual IFPI 2024, seções 3.6 e 3.7)
%
% "O indicativo numérico ... precede o título, alinhado à esquerda,
% separado por um espaço de caractere" e "não usar ponto, hífen,
% travessão, parênteses ou qualquer sinal entre o indicativo e o título".
%
% O padrão do memoir separa por \quad (um espaço largo). A linha abaixo
% troca esse espaço largo por um espaço simples de caractere.
% ----------------------------------------------------------
\renewcommand*{\@seccntformat}[1]{\csname the#1\endcsname\ }

% ----------------------------------------------------------
% SUMÁRIO (manual IFPI 2024, seção 5.1.2.14; ABNT NBR 6027:2012)
%
% "Uniformidade tipográfica por nível de seção -- os destaques do sumário
% devem ser idênticos aos do texto." Por isso os estilos abaixo espelham,
% nível a nível, os destaques definidos mais acima.
% ----------------------------------------------------------
% As seções primária e secundária saem em caixa alta no texto (opções
% section=TITLE e subsection=TITLE de main.tex). O \MakeTextUppercase no
% fim das duas primeiras linhas repete essa caixa alta no sumário.
\renewcommand{\cftsectionfont}{\normalsize\bfseries\MakeTextUppercase}    % primária
\renewcommand{\cftsectionpagefont}{\normalsize}
\renewcommand{\cftsubsectionfont}{\normalsize\MakeTextUppercase}           % secundária
\renewcommand{\cftsubsectionpagefont}{\normalsize}
\renewcommand{\cftsubsubsectionfont}{\normalsize\bfseries}  % terciária
\renewcommand{\cftsubsubsectionpagefont}{\normalsize}
\renewcommand{\cftparagraphfont}{\normalsize\itshape}       % quaternária
\renewcommand{\cftparagraphpagefont}{\normalsize}

% As páginas de abertura de apêndices e anexos são \part; no sumário elas
% também precisam ficar em tamanho 12 (seção 3.6).
\renewcommand{\cftpartfont}{\normalsize\bfseries}
\renewcommand{\cftpartpagefont}{\normalsize\bfseries}

% ----------------------------------------------------------
% TÍTULOS SEM INDICATIVO NUMÉRICO (manual IFPI 2024, seções 3.6.1 e 5.2.3)
%
% "Errata, agradecimentos, lista de ilustrações, lista de abreviaturas e
% siglas, lista de símbolos, sumário, referências, glossário, apêndice(s),
% anexo(s) e índice(s): centralizados, não numerados, com o mesmo destaque
% tipográfico das seções primárias" -- ou seja, maiúsculas, negrito,
% tamanho 12 e centralizados.
%
% A opção chapter=TITLE de main.tex já põe em caixa alta tudo o que é
% impresso com \chapter*. Faltam as páginas de abertura de apêndices e
% anexos, que usam \part e não passam por essa opção.
% ----------------------------------------------------------
\renewcommand{\apendicesname}{AP\^ENDICES}
\renewcommand{\anexosname}{ANEXOS}

% ----------------------------------------------------------
% PAGINAÇÃO (manual IFPI 2024, seção 3.5)
%
% "A numeração aparece a partir da primeira folha da parte textual, em
% algarismos arábicos, no canto superior direito, a 2 cm da borda superior,
% com o último algarismo a 2 cm da borda direita. Em anverso e verso: no
% anverso, canto superior direito; no verso, canto superior esquerdo."
% O tamanho da paginação é 10 (seção 3.1, alínea d).
%
% O recuo lateral já vem das margens do abnTeX2 (2 cm à direita). Aqui
% definimos o estilo de página e aproximamos o número a 2 cm do topo.
% Use \pagestyle{abntifpi} -- é o que estrutura/textual.tex faz.
% ----------------------------------------------------------
\makepagestyle{abntifpi}
\makeoddhead{abntifpi}{}{}{\ABNTEXfontereduzida\thepage}
\makeevenhead{abntifpi}{\ABNTEXfontereduzida\thepage}{}{}
\makeoddfoot{abntifpi}{}{}{}
\makeevenfoot{abntifpi}{}{}{}

% Distância entre a borda superior do papel e o alto do cabeçalho. Com
% \headheight de uma linha, o número fica com a base a cerca de 2 cm do topo.
\setlength{\headheight}{\onelineskip}
\setheaderspaces{1.6cm}{*}{*}

% As margens são fixadas aqui, junto com o cabeçalho (manual, seção 3.2: 3 cm
% à esquerda e no topo, 2 cm à direita e embaixo). Ao recalcular a página, o
% memoir arredonda a altura do texto para um número inteiro de linhas e tira a
% diferença da margem inferior -- era o que deixava a margem de baixo em
% 1,6 cm. A variante [fixed] mantém a altura declarada e preserva os 2 cm.
% No modo twoside, o primeiro valor é a margem interna e o segundo a externa,
% de modo que o verso espelha as margens, como pede a norma.
\setulmarginsandblock{3cm}{2cm}{*}
\setlrmarginsandblock{3cm}{2cm}{*}
\checkandfixthelayout[fixed]

% A folha de abertura dos apêndices e dos anexos (\partapendices e
% \partanexos) é impressa com o estilo de página "part", que o abnTeX2 esvazia
% ao entrar nos elementos pré-textuais e nunca restaura. Sem a linha abaixo,
% essa folha sai sem número e interrompe a paginação contínua exigida pela
% seção 3.5, alínea d. O \AtBeginDocument garante que o ajuste seja aplicado
% depois da configuração dos pré-textuais feita pela classe.
\AtBeginDocument{\aliaspagestyle{part}{abntifpi}}

% ----------------------------------------------------------
% CITAÇÃO COM MAIS DE TRÊS LINHAS (manual IFPI 2024, seção 10.3;
% ABNT NBR 10520:2023)
%
% "Recuo de 4 cm da margem esquerda." O ambiente "citacao" do abnTeX2 monta a
% citação como uma lista e soma o recuo padrão de lista (\leftmargini, cerca
% de 1 cm) aos 4 cm, o que levava o texto a 5 cm da margem. Descontar
% \leftmargini do comprimento usado pelo ambiente devolve os 4 cm exatos.
%
% Precisa ser \AtBeginDocument porque \leftmargini só tem o valor definitivo
% depois que o tamanho da fonte do documento está fixado.
% ----------------------------------------------------------
\AtBeginDocument{%
  \setlength{\ABNTEXcitacaorecuo}{\dimexpr4cm-\leftmargini\relax}%
}

% ----------------------------------------------------------
% NOTAS DE RODAPÉ (manual IFPI 2024, seção 3.13)
%
% "Digitadas dentro das margens, tamanho 10 e uniforme, separadas do texto
% por um espaço simples e por filete de 5 cm a partir da margem esquerda."
%
% O tamanho 10 já vem do abnTeX2 (\foottextfont). Falta o filete: o padrão
% do memoir tem 0,4 da largura do texto, cerca de 6,4 cm.
% ----------------------------------------------------------
\setfootnoterule{3pt}{5cm}{\normalrulethickness}

% ----------------------------------------------------------
% TAMANHO REDUZIDO = 10 (manual IFPI 2024, seção 3.1, alínea d)
%
% \ABNTEXfontereduzida é usado pelo abnTeX2 nas notas de rodapé, nas
% citações longas, no comando \fonte, no comando \nota e na paginação.
% Com corpo do texto em 12, \footnotesize equivale a exatamente 10 pt.
% Se você trocar o 12pt de main.tex, reveja esta definição.
% ----------------------------------------------------------
\renewcommand{\ABNTEXfontereduzida}{\footnotesize}

% ----------------------------------------------------------
% LEGENDAS DE ILUSTRAÇÕES, TABELAS E QUADROS
% (manual IFPI 2024, seções 3.11 e 3.12)
%
% "Identificação na parte superior, centralizada, fonte 12: palavra
% designativa + número de ordem em algarismos arábicos + travessão +
% título." E, abaixo da ilustração, "fonte consultada (obrigatória, mesmo
% que seja produção do próprio autor) ... fonte tamanho 10 e uniforme".
%
% O abnTeX2 já produz o travessão ("Figura 1 -- Título") e o comando
% \fonte já sai em tamanho 10. Falta centralizar as legendas longas, que
% por padrão saem alinhadas à esquerda, e garantir o tamanho 12 no título.
%
% Este ajuste precisa ficar em \AtBeginDocument porque o próprio abnTeX2
% configura o pacote caption nesse momento; aqui ele é aplicado depois.
% ----------------------------------------------------------
\AtBeginDocument{%
  \captionsetup{%
    format=plain,
    justification=centering,
    font=normalsize,
    labelseparator=barr%
  }%
}

% ----------------------------------------------------------
% QUADRO (manual IFPI 2024, seção 3.12)
%
% "Tabela x Quadro: a tabela tem as laterais abertas (dados quantitativos
% ou estatísticos); o quadro é fechado em todos os lados e usado para
% dados qualitativos."
%
% O abnTeX2 traz "figure" e "table"; o quadro é um terceiro tipo de
% flutuante, criado aqui, com numeração e lista próprias:
%
%   \begin{quadro}[htb]
%     \centering
%     \caption{Título do quadro}
%     \label{quad:exemplo}
%     \begin{tabular}{|l|l|}  % fechado em todos os lados
%       \hline ... \hline
%     \end{tabular}
%     \fonte{Elaboração própria.}
%   \end{quadro}
%
% A lista de quadros é impressa por \listadequadros (veja
% pre-textual/opcionais/lista-de-quadros.tex).
% ----------------------------------------------------------
\newcommand{\quadroname}{Quadro}
\newcommand{\listadequadrosname}{Lista de quadros}

% O tipo de flutuante é criado com a interface do pacote float (carregado
% em estrutura/preambulo.tex), e o estilo "plaintop" põe a legenda na
% parte superior, como manda a norma.
\floatstyle{plaintop}
\newfloat{quadro}{htbp}{loq}
\floatstyle{plain}            % devolve o estilo padrão aos demais floats
\floatname{quadro}{\quadroname}

% Numeração e entrada na lista de quadros, nos moldes da lista de figuras.
\newlistof{listadequadros}{loq}{\listadequadrosname}
\newlistentry{quadro}{loq}{0}
\renewcommand{\cftquadroname}{\quadroname\space}
\renewcommand*{\cftquadroaftersnum}{\hfill\textendash\hfill}

% ----------------------------------------------------------
% Caixa de destaque (recurso do modelo, não previsto na norma)
%
% Útil para destacar um trecho durante a escrita. NÃO confunda com o
% quadro da seção 3.12: se o conteúdo é um dado qualitativo do trabalho,
% use o ambiente "quadro" acima, que numera e entra na lista de quadros.
% ----------------------------------------------------------
\newtcbtheorem[]{caixa}{Destaque}{outer arc=0pt,arc=0pt,colframe = cor-quadro,colback = cor-quadro!5}{tha}

% ----------------------------------------------------------
% LISTAS
%
% ALÍNEAS E SUBALÍNEAS (manual IFPI 2024, seções 3.7.1 e 3.7.2) já vêm
% prontas no abnTeX2, nos ambientes "alineas" e "subalineas":
%
%   O texto que antecede as alíneas termina em dois pontos:
%   \begin{alineas}
%     \item primeira alínea, em minúscula e terminada em ponto e vírgula;
%     \item segunda alínea, com subalíneas a seguir:
%     \begin{subalineas}
%       \item subalínea começada por travessão;
%     \end{subalineas}
%     \item última alínea, terminada em ponto final.
%   \end{alineas}
%
% O recuo das alíneas acompanha o \parindent definido em
% configuracoes/espacamentos.tex (1,25 cm pela norma).
%
% O ambiente "lista" abaixo é uma lista com marcadores, fora da norma.
% Use-o apenas onde a numeração progressiva por alíneas não se aplica.
% ----------------------------------------------------------
\newlist{lista}{itemize}{2}
\setlist[lista,1]{label={$\bullet$},topsep=0pt,itemsep=0pt,leftmargin=\parindent+\labelwidth-\labelsep}
\setlist[lista,2]{label={$\circ$},topsep=0pt,itemsep=0pt,leftmargin=*}

% ----------------------------------------------------------
% Comando de formatação de texto para código-fonte inline
% ----------------------------------------------------------
\newcommand{\codigo}{\texttt}

% ----------------------------------------------------------
% Comandos Novos para os Membros da Banca
% Utilize \membroum{Nome} e \membrodois{Nome} para configurar
% ----------------------------------------------------------
\newcommand{\membroumname}{Primeiro membro}
\newcommand{\membrodoisname}{Segundo membro}
\newcommand{\membrotresname}{Terceiro membro}
\newcommand{\dataapresentacaoname}{01 de Janeiro de 1970}
\newcommand{\nomedocursoname}{Nome do Curso}

